# ==============================================================================
# 1. PUBLIC CLIENT CONFIGURATION (Safe for Browser Bundle — RLS Enforced)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=https://salmin-three.vercel.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ==============================================================================
# 2. SERVER-ONLY SECRETS (NEVER prefix with NEXT_PUBLIC_ or VITE_)
#    Configure strictly inside Vercel / Netlify Encrypted Environment Settings
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
TURNSTILE_SECRET_KEY=your-server-only-cloudflare-turnstile-secret-key
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres
METALS_API_KEY=your-server-only-metals-api-key
CRON_SECRET=your-server-only-cron-webhook-secret

# ClickPesa FinTech Gateway (Mobile Money, Tanzanian Banks CRDB/NMB/NBC, International Cards)
CLICKPESA_API_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=your-clickpesa-client-id
CLICKPESA_API_KEY=your-server-only-clickpesa-api-key
CLICKPESA_WEBHOOK_SECRET=your-server-only-clickpesa-hmac-webhook-secret

# ==============================================================================
# 3. GITHUB ACTIONS CI/CD SECRETS (Configure ONLY in GitHub Repository Secrets)
#    salmin16/dosho -> Settings -> Secrets and variables -> Actions
#    NEVER commit real values or expose these in Vercel client bundles
# ==============================================================================
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
# SUPABASE_PROJECT_REF=your_20_char_project_ref
# SUPABASE_DB_PASSWORD=your_postgres_database_password
