# ==============================================================================
# 1. PUBLIC CLIENT CONFIGURATION (Safe for Browser Bundle — RLS Enforced)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=https://salmin-three.vercel.app

# ==============================================================================
# 2. SERVER-ONLY SECRETS (NEVER prefix with NEXT_PUBLIC_ or VITE_)
#    Configure strictly inside Vercel / Netlify Encrypted Environment Settings
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres
METALS_API_KEY=your-server-only-metals-api-key
CRON_SECRET=your-server-only-cron-webhook-secret
